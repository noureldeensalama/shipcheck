# Fixture counterexample: .env.example with placeholders — must NOT fire.
# The secrets scanner special-cases .env.example / .env.sample as safe to commit,
# and these placeholder values deliberately don't match any provider signature.
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
OPENAI_API_KEY=<your-openai-api-key>
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
